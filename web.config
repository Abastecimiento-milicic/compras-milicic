<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    
    <!-- 1. Habilitar compresión estática y dinámica en Azure IIS -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- 2. Definir Tipos MIME para archivos CSV y .gz -->
    <staticContent>
      <remove fileExtension=".csv" />
      <mimeMap fileExtension=".csv" mimeType="text/csv; charset=utf-8" />
      
      <remove fileExtension=".gz" />
      <mimeMap fileExtension=".gz" mimeType="application/gzip" />

      <!-- 3. Instruir al navegador para cachear archivos por 7 días -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- 4. Reglas de encabezados de respuesta para caché local -->
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="public, max-age=604800" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
